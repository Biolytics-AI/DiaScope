vars: {
  d2-config: {
    layout-engine: elk
  }
}

direction: right

style: {
  fill: "#F6F8FB"
  stroke: "transparent"
  font-color: "#0B1220"
}

# Canonical blueprint for PHI-capable GPU processing outside HealthcareProvider's current hosting.
# Visual system translated from the Biolytics AI landing page light theme.
# Exact brand font matching is a render-time concern in D2 rather than a portable source-level setting.

classes: {
  processing_flow: {
    style: {
      stroke: "#002451"
      stroke-width: 2
      font-size: 11
      font-color: "#2B3990"
    }
  }
  audit_flow: {
    style: {
      stroke: "#D97706"
      stroke-width: 2
      stroke-dash: 4
      font-size: 11
      font-color: "#9A3412"
    }
  }
  provider_flow: {
    style: {
      stroke: "#6B7A90"
      stroke-width: 2
      stroke-dash: 5
      font-size: 11
      font-color: "#3C4A5D"
    }
  }
}

HealthcareProvider: "HealthcareProvider EHR Environment" {
  direction: down
  style: {
    fill: "#F8FDFF"
    stroke: "#76D7E7"
    stroke-width: 2
    border-radius: 18
    font-color: "#002451"
    bold: true
  }

  Actors: "Actors" {
    direction: right
    style: {
      fill: "#FFFFFF"
      stroke: "#D6ECF1"
      stroke-width: 1
      border-radius: 12
      font-color: "#002451"
    }

    Doctor: "Doctor / User" {
      shape: person
      style: {
        fill: "#FFFFFF"
        stroke: "#76D7E7"
        stroke-width: 2
        font-color: "#002451"
      }
    }

    DPO: "DPO / Auditor" {
      shape: person
      style: {
        fill: "#FFFFFF"
        stroke: "#76D7E7"
        stroke-width: 2
        font-color: "#002451"
      }
    }
  }

  App: "Clinical Application Layer" {
    direction: down
    style: {
      fill: "#FFFFFF"
      stroke: "#D7E3F0"
      stroke-width: 1
      border-radius: 12
      font-color: "#002451"
    }

    EHR: "EHR Application Server" {
      style: {
        fill: "#FFFFFF"
        stroke: "#9BB6D3"
        stroke-width: 2
        border-radius: 10
        font-color: "#0B1220"
      }
    }
  }

  Controls: "HealthcareProvider Controls" {
    direction: right
    style: {
      fill: "#FFFFFF"
      stroke: "#D7E3F0"
      stroke-width: 1
      border-radius: 12
      font-color: "#002451"
    }

    Authz: "Access Control\n(service authorization)" {
      shape: hexagon
      style: {
        fill: "#ECFCFD"
        stroke: "#06E1EC"
        stroke-width: 2
        font-color: "#002451"
      }
    }

    ClientAuth: "mTLS Client Auth\n+ API Credential" {
      shape: hexagon
      style: {
        fill: "#ECFCFD"
        stroke: "#06E1EC"
        stroke-width: 2
        font-color: "#002451"
      }
    }
  }

  Actors.Doctor -> App.EHR: "clinical request" { class: processing_flow }
  App.EHR -> Controls.Authz: "authorize inference use" { class: processing_flow }
  Controls.Authz -> Controls.ClientAuth: "prepare authenticated call" { class: processing_flow }
}

Biolytics: "Biolytics-Managed External Processing" {
  direction: down
  style: {
    fill: "#FBFFFF"
    stroke: "#06E1EC"
    stroke-width: 2
    border-radius: 18
    font-color: "#002451"
    bold: true
  }

  Runtime: "Private Network Enclave" {
    direction: down
    style: {
      fill: "#FFFFFF"
      stroke: "#BCEBF0"
      stroke-width: 1
      border-radius: 12
      font-color: "#002451"
    }

    Ingress: "Security Group / Allowlist\n(HealthcareProvider endpoints only)" {
      shape: hexagon
      style: {
        fill: "#ECFCFD"
        stroke: "#06E1EC"
        stroke-width: 2
        font-color: "#002451"
      }
    }

    TLS: "TLS 1.2+\ntermination" {
      shape: hexagon
      style: {
        fill: "#ECFCFD"
        stroke: "#06E1EC"
        stroke-width: 2
        font-color: "#002451"
      }
    }

    Inference: "vLLM Inference Service\n(non-root, read-only rootfs)" {
      style: {
        fill: "#FFFFFF"
        stroke: "#2B3990"
        stroke-width: 2
        border-radius: 10
        font-color: "#0B1220"
      }
    }

    OpsAccess: "Operational Access Control\n(least privilege, MFA, SSH keys)" {
      shape: hexagon
      style: {
        fill: "#ECFCFD"
        stroke: "#06E1EC"
        stroke-width: 2
        font-color: "#002451"
      }
    }

    Ingress -> TLS: "allowlisted traffic" { class: processing_flow }
    TLS -> Inference: "decrypted inference request" { class: processing_flow }
    Inference -> TLS: "encrypted response" { class: processing_flow }
    OpsAccess -> Inference: "controlled operations access" { class: provider_flow }
  }

  Storage: "Application Storage and Logging" {
    direction: right
    style: {
      fill: "#FFFFFF"
      stroke: "#BCEBF0"
      stroke-width: 1
      border-radius: 12
      font-color: "#002451"
    }

    EncVolume: "Encrypted Volume\n(customer-managed controls)" {
      shape: cylinder
      style: {
        fill: "#F4FCFF"
        stroke: "#76D7E7"
        stroke-width: 2
        font-color: "#002451"
      }
    }

    Weights: "Model Weights\n(checksum verified on load)" {
      shape: stored_data
      style: {
        fill: "#F4FCFF"
        stroke: "#76D7E7"
        stroke-width: 2
        font-color: "#002451"
      }
    }

    SafeAudit: "PHI-Safe Audit Log\n(session IDs, timestamps, metadata only)" {
      shape: document
      style: {
        fill: "#FFF4E8"
        stroke: "#E7B56A"
        stroke-width: 2
        font-color: "#9A3412"
      }
    }
  }

  Runtime.Inference -> Storage.EncVolume: "ephemeral read / write" { class: provider_flow }
  Runtime.Inference -> Storage.Weights: "load model + verify checksum" { class: processing_flow }
  Runtime.Inference -> Storage.SafeAudit: "metadata-only audit event" { class: audit_flow }
}

GPUProvider: "GPU Cloud Provider IaaS Layer" {
  direction: down
  style: {
    fill: "#F9FBFE"
    stroke: "#C5D2E2"
    stroke-width: 2
    border-radius: 18
    font-color: "#002451"
    bold: true
  }

  EURegion: "EU Data Center / Region Lock" {
    shape: cloud
    style: {
      fill: "#EEF3F9"
      stroke: "#A9B8CC"
      stroke-width: 2
      font-color: "#3C4A5D"
    }
  }

  Hypervisor: "Hypervisor / Bare Metal" {
    style: {
      fill: "#FFFFFF"
      stroke: "#C5D2E2"
      stroke-width: 2
      border-radius: 10
      font-color: "#0B1220"
    }
  }

  GPU: "GPU Hardware\n(H100 / H200 / B200 class)" {
    shape: hexagon
    style: {
      fill: "#EEF3F9"
      stroke: "#A9B8CC"
      stroke-width: 2
      font-color: "#3C4A5D"
    }
  }

  Physical: "Physical DC Security\n(provider-controlled)" {
    shape: stored_data
    style: {
      fill: "#EEF3F9"
      stroke: "#A9B8CC"
      stroke-width: 2
      font-color: "#3C4A5D"
    }
  }

  EURegion -> Hypervisor: "regional placement" { class: provider_flow }
  Hypervisor -> GPU: "executes workload" { class: provider_flow }
  Physical -> Hypervisor: "physical security coverage" { class: provider_flow }
}

Audit: "Audit and Compliance Artifacts" {
  direction: down
  style: {
    fill: "#FFF9F2"
    stroke: "#E7B56A"
    stroke-width: 2
    border-radius: 18
    font-color: "#9A3412"
    bold: true
  }

  AppLog: "Application Audit Log\n(metadata trail)" {
    shape: document
    style: {
      fill: "#FFF4E8"
      stroke: "#E7B56A"
      stroke-width: 2
      font-color: "#9A3412"
    }
  }

  InfraLog: "Infrastructure Access Log\n(SSH, console, cloud trail)" {
    shape: document
    style: {
      fill: "#FFF4E8"
      stroke: "#E7B56A"
      stroke-width: 2
      font-color: "#9A3412"
    }
  }

  DeployProv: "Deployment Provenance\n(image tag, model checksum)" {
    shape: document
    style: {
      fill: "#FFF4E8"
      stroke: "#E7B56A"
      stroke-width: 2
      font-color: "#9A3412"
    }
  }

  KeyLog: "Key Rotation Log\n(who, when, approval)" {
    shape: document
    style: {
      fill: "#FFF4E8"
      stroke: "#E7B56A"
      stroke-width: 2
      font-color: "#9A3412"
    }
  }

  DPA: "Signed DPA / Processor Agreement\n(audit rights, incident clauses)" {
    shape: page
    style: {
      fill: "#FFF7E8"
      stroke: "#D9A24D"
      stroke-width: 2
      font-color: "#9A3412"
    }
  }

  ProviderEvidence: "Provider Evidence\n(ISO 27001, SOC 2, regional scope)" {
    shape: page
    style: {
      fill: "#FFF7E8"
      stroke: "#D9A24D"
      stroke-width: 2
      font-color: "#9A3412"
    }
  }
}

Legend: "Legend" {
  direction: down
  style: {
    fill: "#FFFFFF"
    stroke: "#D7E3F0"
    stroke-width: 1
    border-radius: 16
    font-color: "#002451"
    bold: true
  }

  NodeTypes: "Node Types" {
    direction: right
    style: {
      fill: "#FFFFFF"
      stroke: "#E6EEF7"
      stroke-width: 1
      border-radius: 12
      font-color: "#002451"
    }

    LActor: "Actor" {
      shape: person
      style: {
        fill: "#FFFFFF"
        stroke: "#76D7E7"
        stroke-width: 2
        font-color: "#002451"
      }
    }

    LService: "Service / Process" {
      style: {
        fill: "#FFFFFF"
        stroke: "#9BB6D3"
        stroke-width: 2
        border-radius: 10
        font-color: "#0B1220"
      }
    }

    LControl: "Security Control" {
      shape: hexagon
      style: {
        fill: "#ECFCFD"
        stroke: "#06E1EC"
        stroke-width: 2
        font-color: "#002451"
      }
    }

    LEncrypted: "Encrypted Storage" {
      shape: cylinder
      style: {
        fill: "#F4FCFF"
        stroke: "#76D7E7"
        stroke-width: 2
        font-color: "#002451"
      }
    }

    LStore: "Data / Model Store" {
      shape: stored_data
      style: {
        fill: "#F4FCFF"
        stroke: "#76D7E7"
        stroke-width: 2
        font-color: "#002451"
      }
    }

    LAudit: "Audit Log / Evidence" {
      shape: document
      style: {
        fill: "#FFF4E8"
        stroke: "#E7B56A"
        stroke-width: 2
        font-color: "#9A3412"
      }
    }

    LLegal: "Certificate / Legal Document" {
      shape: page
      style: {
        fill: "#FFF7E8"
        stroke: "#D9A24D"
        stroke-width: 2
        font-color: "#9A3412"
      }
    }

    LCloud: "Cloud / Provider Boundary" {
      shape: cloud
      style: {
        fill: "#EEF3F9"
        stroke: "#A9B8CC"
        stroke-width: 2
        font-color: "#3C4A5D"
      }
    }
  }

  EdgeTypes: "Edge Semantics" {
    direction: right
    style: {
      fill: "#FFFFFF"
      stroke: "#E6EEF7"
      stroke-width: 1
      border-radius: 12
      font-color: "#002451"
    }

    ReqStart: ""
    ReqEnd: "Required processing flow"
    AuditStart: ""
    AuditEnd: "Audit / reporting flow"
    ProvStart: ""
    ProvEnd: "Provider / evidence flow"

    ReqStart -> ReqEnd: "solid" { class: processing_flow }
    AuditStart -> AuditEnd: "dashed" { class: audit_flow }
    ProvStart -> ProvEnd: "dashed" { class: provider_flow }
  }
}

HealthcareProvider.Controls.ClientAuth -> Biolytics.Runtime.Ingress: "authenticated request carrying clinical context" { class: processing_flow }
Biolytics.Runtime.TLS -> HealthcareProvider.App.EHR: "encrypted response returned to EHR" { class: processing_flow }
Biolytics.Runtime.Inference -> GPUProvider.Hypervisor: "runs on provider infrastructure" { class: provider_flow }

Biolytics.Storage.SafeAudit -> Audit.AppLog: "writes operational metadata" { class: audit_flow }
Biolytics.Storage.Weights -> Audit.DeployProv: "records model checksum at deploy time" { class: audit_flow }
Biolytics.Storage.EncVolume -> Audit.KeyLog: "records key rotation events" { class: audit_flow }
GPUProvider.Physical -> Audit.InfraLog: "provider access and facility trail" { class: provider_flow }
GPUProvider.EURegion -> Audit.ProviderEvidence: "regional hosting evidence" { class: provider_flow }
GPUProvider.Physical -> Audit.ProviderEvidence: "certifications and audit reports" { class: provider_flow }
GPUProvider.Hypervisor -> Audit.DPA: "covered by processor agreement" { class: provider_flow }

HealthcareProvider.Actors.DPO -> Audit.AppLog: "review application audit trail" { class: audit_flow }
HealthcareProvider.Actors.DPO -> Audit.ProviderEvidence: "review provider evidence" { class: audit_flow }
HealthcareProvider.Actors.DPO -> Audit.DPA: "review contractual basis" { class: audit_flow }
